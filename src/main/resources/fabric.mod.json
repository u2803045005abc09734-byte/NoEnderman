  },
  "license": "LGPL-3.0-only",
  "icon": "assets/endit/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": ["net.yeoxuhang.endit.EnditFabric"]
  },
  "mixins": ["endit.mixins.json"],
  "depends": {
    "fabricloader": ">=0.19.5",
